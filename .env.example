# Required: your TypeSafe/Jev API key
JEV_API_KEY=your-typesafe-key

# Optional: leave these out to use a local Ollama model instead.
# If you set OPENAI_API_KEY, also set the three model names below,
# or the pipeline will try to send OpenAI a local model name and fail.
OPENAI_API_KEY=sk-your-openai-key
OPENAI_BASE_URL=https://api.openai.com/v1

# Three separate roles. You can mix models freely.
DEFAULT_CODE_MODEL=gpt-4.1
DEFAULT_TEST_MODEL=gpt-4.1
DEFAULT_JUDGE_MODEL=gpt-4o

# Optional: retry limits (defaults shown)
MAX_LINT_ATTEMPTS=3
MAX_SEMANTIC_ATTEMPTS=3
MAX_EXECUTION_ATTEMPTS=3
